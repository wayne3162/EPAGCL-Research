# Preserve exported research records
!/research_results/**/*.txt

# Preserve experiment documentation
!/extension_experiments/efficiency_B/README*.txt
!/extension_experiments/formal_A/source_sha256.txt

# Preserve unit tests
!/extension_experiments/tests/
!/extension_experiments/tests/test*.py


# Preserve node prediction results
!/cora_trace/test_predictions.csv
!/cora_explore/test_predictions.csv

# Preserve research audit notes
!/midterm_audit/*.txt


